rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == 'admin');
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.get('banned', false) == false;
      allow read, delete: if signedIn() && request.auth.uid == userId || isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
          request.resource.data.get('banned', false) == resource.data.get('banned', false));

      match /recipes/{recipeId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId || isAdmin();
      }
    }

    // Collection-group queries need a recursive match in addition to the
    // user-scoped rule above. Only admins can query every user's recipes.
    match /{path=**}/recipes/{recipeId} {
      allow read: if isAdmin();
    }
  }
}